    ```python
    @contextmanager
def security_scanning_integration_context(
    resource_id: str,
    options: dict[str, Any] | None = None,
) -> Generator[SecurityScanningIntegrationSession, None, None]:
    """Create a managed context for security scanning integration.

    Ensures proper resource acquisition and cleanup following
    the project's ci/cd python configuration conventions.

    Args:
        resource_id: Identifier for the resource to manage.
        options: Optional configuration overrides.

    Yields:
        A configured session object.
    """
    options = options or {}
    logger = logging.getLogger(__name__)
    logger.debug("Acquiring security_scanning_integration resource: %s", resource_id)

    session = SecurityScanningIntegrationSession(resource_id, **options)
    try:
        session.initialize()
        yield session
    except Exception:
        logger.exception("Error in security_scanning_integration context")
        raise
    finally:
        session.cleanup()
        logger.debug("Released security_scanning_integration resource: %s", resource_id)
    ```

