    ```python
    @contextmanager
def testing_async_code_with_pytest_context(
    resource_id: str,
    options: dict[str, Any] | None = None,
) -> Generator[TestingAsyncCodeWithPytestasynSession, None, None]:
    """Create a managed context for testing async code with pytest-asyncio.

    Ensures proper resource acquisition and cleanup following
    the project's async/await patterns conventions.

    Args:
        resource_id: Identifier for the resource to manage.
        options: Optional configuration overrides.

    Yields:
        A configured session object.
    """
    options = options or {}
    logger = logging.getLogger(__name__)
    logger.debug("Acquiring testing_async_code_with_pytest resource: %s", resource_id)

    session = TestingAsyncCodeWithPytestasynSession(resource_id, **options)
    try:
        session.initialize()
        yield session
    except Exception:
        logger.exception("Error in testing_async_code_with_pytest context")
        raise
    finally:
        session.cleanup()
        logger.debug("Released testing_async_code_with_pytest resource: %s", resource_id)
    ```

